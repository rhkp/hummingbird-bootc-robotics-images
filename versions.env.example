## Single source of truth for every image's build args. build/build.sh and
## build/build-all.sh source this file and pass every entry through as
## --build-arg KEY=VALUE. See README.md for why each pin exists and the
## discipline for updating them.
##
## Copy this to versions.env and set REGISTRY to your own quay.io/Docker Hub
## namespace (versions.env is gitignored — this .example is the committed
## template, same pattern as this project's other per-deployer config):
##   cp versions.env.example versions.env

BOOTC_OS_IMAGE=quay.io/hummingbird-community/bootc-os:latest
FEDORA_FALLBACK_RELEASE=43
ROS_DISTRO=jazzy
COMPILERS_VERSION=1.11.0

# Source pins — captured via `git ls-remote`, never a floating branch name.
# Update deliberately when intentionally moving to a newer upstream commit,
# not as a side effect of an unrelated rebuild.
RMF_DEMOS_COMMIT=3f7b9727ce39ba421ba5727eed9d8612f1c85f66
AMENT_CMAKE_COMMIT=5741cff5b9f83253bf3521bd8f44108fde3504ad
RMF_WEB_REF=85a34c3ec6481796d7c0eba745d9221055121656

# Registry / tagging — REGISTRY is per-deployer, replace with your own
REGISTRY=quay.io/your-org
RELEASE_TAG=v0.1.0
