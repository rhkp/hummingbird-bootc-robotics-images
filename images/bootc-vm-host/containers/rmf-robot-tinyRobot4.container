# The robot image owns the generic Nav2/SLAM/Zenoh runtime. The world image
# owns the single RMF fleet adapter.
[Unit]
Description=OpenRMF robot-as-pod: tinyRobot4 (Nav2 + SLAM)
After=rmf-simulation.service
Requires=rmf-simulation.service

[Container]
Image=REGISTRY_PLACEHOLDER/hbr-rmf-robot:latest
ContainerName=rmf-robot-tinyRobot4
Network=host
Pull=never
GlobalArgs=--storage-opt=additionalimagestore=/usr/lib/bootc/storage
ShmSize=64m
Exec=/opt/rmf/scripts/launch-robot.sh
Environment=ROBOT_NAME=tinyRobot4
Environment=ZENOH_ROUTER_ENDPOINT=tcp/localhost:7447
Environment=QT_QPA_PLATFORM=offscreen
Environment=LIBGL_ALWAYS_SOFTWARE=1

[Service]
Restart=always
TimeoutStartSec=360

[Install]
WantedBy=multi-user.target
