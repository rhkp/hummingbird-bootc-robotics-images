# The tools image owns launch-fleet-coordinator.sh and fleet-coordinator.py.
[Unit]
Description=OpenRMF fleet coordinator (centralized task assignment)
After=rmf-simulation.service
Requires=rmf-simulation.service

[Container]
Image=REGISTRY_PLACEHOLDER/hbr-rmf-tools:latest
ContainerName=rmf-fleet-coordinator
Network=host
Pull=never
GlobalArgs=--storage-opt=additionalimagestore=/usr/lib/bootc/storage
ShmSize=64m
Exec=/opt/rmf/scripts/launch-fleet-coordinator.sh
Environment=ZENOH_ROUTER_ENDPOINT=tcp/localhost:7447

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
