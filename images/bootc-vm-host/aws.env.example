# AWS account-specific config for build-ami.sh / register-and-launch.sh.
# Copy to aws.env and fill in your own account's values (aws.env is
# gitignored — this .example is the committed template):
#   cp images/bootc-vm-host/aws.env.example images/bootc-vm-host/aws.env
#
# All of these can also be set as plain exported env vars instead of via
# this file — see each script's own resolution order.

# S3 bucket used to stage the AMI upload (bootc-image-builder's --aws-bucket).
S3_BUCKET=your-s3-bucket-name

# A subnet in the VPC you want to launch the demo VM into.
EC2_SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx

# A security group in that same VPC with inbound 22 (SSH) open. A second,
# dedicated security group for port 8080 (noVNC) is created automatically
# alongside this one — this only needs to cover SSH.
BASE_SECURITY_GROUP=sg-xxxxxxxxxxxxxxxxx
